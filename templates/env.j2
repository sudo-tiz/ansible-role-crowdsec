TZ={{ crowdsec_environment_variables_tz }}
COLLECTIONS={{ crowdsec_collections | join(' ') }}
{% if crowdsec_traefik_bouncer_enabled and crowdsec_bouncer_key %}
BOUNCER_KEY_traefik={{ crowdsec_bouncer_key }}
{% endif %}
{% if crowdsec_enroll_key %}
ENROLL_KEY={{ crowdsec_enroll_key }}
{% endif %}
{% if crowdsec_enroll_instance_name %}
ENROLL_INSTANCE_NAME={{ crowdsec_enroll_instance_name }}
{% endif %}
{% if crowdsec_enroll_tags | length > 0 %}
ENROLL_TAGS={{ crowdsec_enroll_tags | join(' ') }}
{% endif %}
{{ crowdsec_environment_variables_additional_variables }}
